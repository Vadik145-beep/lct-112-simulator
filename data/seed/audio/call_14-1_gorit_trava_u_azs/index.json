{
  "opening": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Здравствуйте, у нас рядом с заправкой горит сухая трава. Огонь идёт прямо к территории, мы тут работаем!",
    "bytes": 97846,
    "sha256": "28007062e71d8f33324206479418223cacdaa9c86279fd5ff32dc92539b2739e"
  },
  "r1": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Горит сухая трава. Рядом с нашей заправкой, за забором.",
    "bytes": 60648,
    "sha256": "d5c85d29d29170c800334652514b19e598b1a16f62678fadee0ad5ea96754745"
  },
  "r2": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Огонь идёт к территории. Уже метров десять осталось до отбойника.",
    "bytes": 64827,
    "sha256": "e3bb860b486197c91afc49f49a686000771e72318cffa7e998186c99fd579b1d"
  },
  "r3": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Это область, Московская. Трасса М-два.",
    "bytes": 38078,
    "sha256": "9ca8fc6f53b6dc96537c152b7106189220d8bdd8dc123457cf234885cb35ca26"
  },
  "r4": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Заправка Роснефть, не доезжая до Расторгуевского шоссе. По столбам двадцать пятый километр в сторону Москвы, владение два.",
    "bytes": 119998,
    "sha256": "fe2e9bbbe225f355d96832009a3a5c7e23ca77176ef777ef1444c4b0e9c36a11"
  },
  "r5": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Пострадавших нет. Все на ногах, никто не обжёгся.",
    "bytes": 51035,
    "sha256": "71872a38b624156c436949f85e603f530e015785a5617e60d5a2b7efe217b6d0"
  },
  "r6": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Тут колонки и резервуар. Ветер прямо на нас тянет.",
    "bytes": 53124,
    "sha256": "3feea59e8b14f86a63de0b08c96eff5c4d70cb8d53e5a8860109433a5a705ed1"
  },
  "r7": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "На смене нас двое. Клиентов сейчас трое на заправке.",
    "bytes": 54378,
    "sha256": "969ba496ed8a89fda03db2b4543d88c5ff14759b0709b3758b3dfedbb7a45579"
  },
  "r8": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Минут пять как заметили. Сначала дымок был, теперь полоса огня.",
    "bytes": 62737,
    "sha256": "421875115d3c1e71f443dc7e416df4f30bb7a336f2029ff1edb532e8d00aa95a"
  },
  "r9": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Потапов Иван Сергеевич. Работник заправки.",
    "bytes": 47273,
    "sha256": "fd1de5d455d1d6ed62cd0357f39193e5ad62d343cbe2b60a78e69d62f7e663ed"
  },
  "r10": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Девять один шесть, сто двадцать три, девяносто восемь, семьдесят восемь.",
    "bytes": 81128,
    "sha256": "cade1c0037f451e38722d03502da86eee1d7ff854f956dbad806769ffd12d06e"
  },
  "r11": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Я тут работаю, оператор смены. Звоню с рабочего места.",
    "bytes": 53124,
    "sha256": "ccb6e09d563a65de71ab18b5a6dcc2e5a0839e096e6e7e91aa403abfd1336806"
  },
  "r12": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Заезд с трассы, шлагбаум подниму. Подъездов нет, это заправка.",
    "bytes": 64827,
    "sha256": "8638aa6e14005b35220210a6bb24ca6bda0736e7633b0f479069481d944b3850"
  },
  "r13": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Повторите, пожалуйста, тут фуры проходят.",
    "bytes": 34316,
    "sha256": "93b6a553e0493ea4e31f5cf1fb7257452192606a3d093a2b87ee865463b56e45"
  },
  "r14": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Не знаю. Нам колонки глушить и людей отводить?",
    "bytes": 44347,
    "sha256": "e9f8cc636b42cea7a3f8fb02598a6a4904c0f4fad8e2bfa737446881204d0c7f"
  }
}
