{
  "opening": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Помогите, у нас покупателю плохо! Его трясёт, пена изо рта, он упал и голову разбил!",
    "bytes": 76948,
    "sha256": "c279ff62621c81712de4be465dc6b3dd219e806dc28e47208db350c07f99fa41"
  },
  "r1": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Мужчине плохо! Его трясёт всего, пена изо рта идёт.",
    "bytes": 45601,
    "sha256": "64813fda2348a3bcf34dda75220b6c669ca7c9997714565b5fc982a7914cad7c"
  },
  "r2": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Он упал прямо у касс и головой о плитку ударился. Кровь есть.",
    "bytes": 53124,
    "sha256": "045cc5cc1109e4c4c2b90500b320e6b3c8eae04e1f795a3d69419e5cde7c4a15"
  },
  "r3": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Магазин Лента, у касс. Мы на улице Твардовского.",
    "bytes": 40586,
    "sha256": "836c781d2cc5703c234a57631e873cf85c0c019827533748ad95b497931772e4"
  },
  "r4": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Владение два, корпус один. Вход с парковки.",
    "bytes": 36824,
    "sha256": "9b58c3f0763ded9c9e2481b2e175b6ed2d0f9c0aa509bc1897fc22f063408559"
  },
  "r5": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Москва, Строгино.",
    "bytes": 18016,
    "sha256": "222105031dfa6200ac23beb98acd907104c7521622590823b0009a806f97db54"
  },
  "r6": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Один мужчина, лет сорок пять. Имени не знаем, он покупатель.",
    "bytes": 47691,
    "sha256": "4e4196fb3c4f00d2eae30855d123d67728ed149cb3f1328517d7317be2848367"
  },
  "r7": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Судороги были, сейчас затихает. Голова разбита, кровь на полу.",
    "bytes": 53124,
    "sha256": "0c19e9d8af94812b4b29b6092eaa5240f67acf4bace77969a075cd722ad52678"
  },
  "r8": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Мы куртку под голову подложили. Покупателей отодвинули.",
    "bytes": 47691,
    "sha256": "d66c698718564232e108e2a76638aba7cfadd48ce51bf4afd68c7a14bd21e734"
  },
  "r9": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Он один упал. Народу в зале много, человек двадцать у касс.",
    "bytes": 47273,
    "sha256": "886c0c96cfc4984df2f29b468104a42718ad03a5e0e8abe26d53ad746bf9a80a"
  },
  "r10": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Минуты две назад. Я сразу вам позвонила.",
    "bytes": 34316,
    "sha256": "1cd870f9bdc580d30f2df8b3a5bab5c76daa2cf5ac5df4259c5504e14d698050"
  },
  "r11": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Соколова Вера Ивановна, кассир я.",
    "bytes": 33062,
    "sha256": "354dce893bb7d327b018c3961ca3b908b93c2fe612cc46e106728f87561c7ad0"
  },
  "r12": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Девять один шесть, триста двадцать, двенадцать, восемьдесят три.",
    "bytes": 53124,
    "sha256": "71b1b7584d6285c0528be2ce75407bc16139f24603881dbea7e29b98b065ed2b"
  },
  "r13": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Я тут работаю, кассир. Его не знаю.",
    "bytes": 30973,
    "sha256": "2321af3d8ac9f2ebb6559e10efcd0b5ad6d6679c44ca7d3af4d75dc665ca93eb"
  },
  "r14": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Это магазин, первый этаж. Вход с парковки, я встречу.",
    "bytes": 49363,
    "sha256": "985ab69544e2c8980dc5303b814fe09821aedffc479cd1200d0f96f99fcdd0b9"
  },
  "r15": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Что? Тут шумно, повторите!",
    "bytes": 30137,
    "sha256": "8971a164630279c5634883ee71a0cb1925bce3dbac0f2dc823dc0ab66aa38494"
  },
  "r16": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Не знаю. Его на бок повернуть или не трогать?",
    "bytes": 38078,
    "sha256": "4203895f4daf9b512e6e8c475acfa9d28d936432a2cf84be7f33b9be12fb704d"
  }
