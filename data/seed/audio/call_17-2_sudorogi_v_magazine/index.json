    "sha256": "7c82ffa238a0adee647de7223a923ba16051de4d3ec23bd64ee7fdf431b5ca04"
  },
  "r16": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[shaky voice] [nervous]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Не знаю. Его на бок повернуть или не трогать?",
