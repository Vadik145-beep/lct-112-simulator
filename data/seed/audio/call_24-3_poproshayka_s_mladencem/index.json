    "model": "eleven_v3",
    "tag": "[anxious] [fast]",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Улица Красная Пресня, напротив метро тысяча девятьсот пятого года.",
    "bytes": 62319,
    "sha256": "76bfb0afd022cb7838689e5419423ff775b5d69f070d0065cee7017ca0476135"
  },
  "r4": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_v3",
    "tag": "[anxious] [fast]",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Москва, Пресненский район.",
