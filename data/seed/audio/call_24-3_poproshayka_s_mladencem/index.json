    "model": "eleven_v3",
    "tag": "[anxious] [fast]",
    "speed": 1.0,
    "stability": 0.5,
    "text": "У ребёнка лицо в крови. Откуда — не знаю, но кровь свежая, размазана.",
    "bytes": 71515,
    "sha256": "ad6437550d3fc6a02fd8f2fedb900a2bd6d619f4502fda022e6fdbea89ec9700"
  },
