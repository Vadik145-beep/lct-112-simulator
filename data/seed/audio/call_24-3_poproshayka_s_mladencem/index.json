    "sha256": "3ce7231642fe61674bedbf2f41880eec89de38a17ba507c73edc3cf4b0d486c8"
  },
  "r11": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_v3",
    "tag": "[anxious] [fast]",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Девять один шесть, восемьсот девяносто шесть, тридцать два, пятьдесят четыре.",
