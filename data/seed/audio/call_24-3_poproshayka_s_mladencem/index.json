    "sha256": "7dceba43c8e22f88d31df39cd9d7dafbb488581b15b49c25bc50816ece804f18"
  },
  "r6": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_v3",
    "tag": "[anxious] [fast]",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Женщина на вид целая. Ни ран, ни крови на ней.",
