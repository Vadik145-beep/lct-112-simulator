    "model": "eleven_v3",
    "tag": "[anxious] [fast]",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Она ребёнка на руках трясёт, когда идёт. Людей за одежду хватает.",
    "bytes": 71515,
    "sha256": "df31d69af64a9000fe6a9b5ff92da1eb8c8755c81ab472364856731f65cd8585"
