  },
  "r1": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_v3",
    "tag": "[anxious] [fast]",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Женщина попрошайничает с младенцем. Хватает людей за рукава, денег просит.",
    "bytes": 88233,
    "sha256": "ba0c0e375e79dcc8b89685db81c00f966f0042939e8236c218b264adfccb321f"
  },
  "r2": {
