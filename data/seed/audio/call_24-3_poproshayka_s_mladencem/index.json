    "sha256": "5f27afaa6dd09e66f45937b5df19ab2361e19e4aefd74336c8ad40daa0dd96e1"
  },
  "r12": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_v3",
    "tag": "[anxious] [fast]",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Я очевидец, прохожая. Отношения к ней не имею.",
