    "sha256": "af13af272192e438bb86b9231897f79fd6f521c9e1dd1a97710f2d0cd35b2ae0"
  },
  "r5": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_v3",
    "tag": "[anxious] [fast]",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Ребёнок совсем маленький, месяцев шесть. Лицо в крови, плачет.",
