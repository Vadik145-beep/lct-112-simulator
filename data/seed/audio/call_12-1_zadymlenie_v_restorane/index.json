    "model": "eleven_v3",
    "tag": "[anxious] [fast]",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Огня я не видел. Только дым, но плотный, стен уже не разглядеть.",
    "bytes": 76530,
    "sha256": "1af289a2d238cdef59a251ca951b8f3151f6adaedaa34659afc5014547533953"
  },
