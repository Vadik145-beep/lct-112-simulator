    "model": "eleven_v3",
    "tag": "[anxious] [fast]",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Дым плотный, тянет в зал. Персонал двери на улицу открыл.",
    "bytes": 57304,
    "sha256": "d5e7fd6021bec4acd28381c82e08be057827c35dd126b58a4dfa1f86805d3095"
  },
