{
  "opening": {
    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[urgent] [fast]",
    "speed": 1.05,
    "stability": 0.4,
    "text": "Ой, тут автобус горит! Кабина водителя занялась, дым валит, пассажиры вышли!",
    "bytes": 70261,
    "sha256": "815672e43670d1a41f57e3a974dcfb16a788b98423cb79d482e35243bdfff04e"
  },
  "r1": {
    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[urgent] [fast]",
    "speed": 1.05,
    "stability": 0.4,
    "text": "Автобус горит! Кабина водителя занялась, из-под панели дым валит.",
    "bytes": 75276,
    "sha256": "1bec1314c5eb20d4c235abe3620e63f6159c68036c312e17a8dde03efd315132"
  },
  "r2": {
    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[urgent] [fast]",
    "speed": 1.05,
    "stability": 0.4,
    "text": "Уже пламя видно через лобовое. Водитель огнетушителем пробовал, не помогает.",
    "bytes": 76530,
    "sha256": "d787966a6c60cb144dce8dd0728d599e5c88cc27def1e2b0e0155e782823ca71"
  },
  "r3": {
    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[urgent] [fast]",
    "speed": 1.05,
    "stability": 0.4,
    "text": "Дмитровское шоссе, в сторону области. У автобусной остановки.",
    "bytes": 56050,
    "sha256": "30459e4ada9f4e02172dec2ff318929e2a00ec9df7c133b3bbe46344b5c27f87"
  },
  "r4": {
    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[urgent] [fast]",
    "speed": 1.05,
    "stability": 0.4,
    "text": "Остановка называется Лианозовский электромеханический завод. Номера дома тут нет.",
    "bytes": 79038,
    "sha256": "7977987e60b2d19b00192dacdd76c35de014ecb7b42333b7e6ac3814e4bca6fd"
  },
  "r5": {
    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[urgent] [fast]",
    "speed": 1.05,
    "stability": 0.4,
    "text": "Москва пока, но до области рядом.",
    "bytes": 38078,
    "sha256": "8633747b6f02cbb1608c1ff0fba59bbc135278fe4bb2eb281de28087a8a4ff88"
  },
  "r6": {
    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[urgent] [fast]",
    "speed": 1.05,
    "stability": 0.4,
    "text": "Пострадавших нет. Все вышли, и водитель тоже.",
    "bytes": 43511,
    "sha256": "67359235b3afd95bb36ff918878a00efbe9606934bfe0375eff0cda4b81f43da"
  },
  "r7": {
    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[urgent] [fast]",
    "speed": 1.05,
    "stability": 0.4,
    "text": "Бак сзади, а горит спереди. Люди близко стоят, я их отгоняю.",
    "bytes": 65245,
    "sha256": "f751607965cc9b5477bc2f383aeacd9a433a12248d9d406270c9d6dcd1d11e2a"
  },
  "r8": {
    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[urgent] [fast]",
    "speed": 1.05,
    "stability": 0.4,
    "text": "Автобус, маршрут шестьдесят три. Бортовой номер пятнадцать тысяч четыреста семьдесят семь.",
    "bytes": 81546,
    "sha256": "ecd731ce7e3d6f75e0f19473fea59410e4ef611ed9b439a50bc7de141dbe2a74"
  },
  "r9": {
    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[urgent] [fast]",
    "speed": 1.05,
    "stability": 0.4,
    "text": "Государственный знак не скажу, он спереди, а там всё в дыму.",
    "bytes": 71515,
    "sha256": "26398135a021eed94934582c692ae9da788e0364a75be260a08267fd4a6dea4c"
  },
  "r10": {
    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[urgent] [fast]",
    "speed": 1.05,
    "stability": 0.4,
    "text": "Пассажиров было человек двадцать, все на остановке стоят.",
    "bytes": 56050,
    "sha256": "75378473ac0f9d6fbc79c2af897e2267882cc3326c43f4cc10841d0f6e881a1c"
  },
  "r11": {
    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[urgent] [fast]",
    "speed": 1.05,
    "stability": 0.4,
    "text": "Минуты две назад задымило, сейчас уже горит.",
    "bytes": 38078,
    "sha256": "49a58db3fc87897ab3279c20cc15a34fc80f3eaf2ea2ef52aae4374ba27bfd61"
  },
  "r12": {
    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[urgent] [fast]",
    "speed": 1.05,
    "stability": 0.4,
    "text": "Титов Павел Петрович.",
    "bytes": 28047,
    "sha256": "ba372288e7a3adf3fb51a22f4c1305ad0d48d0752fb004c2526bc313efec2ca0"
  },
  "r13": {
    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[urgent] [fast]",
    "speed": 1.05,
    "stability": 0.4,
    "text": "Девять один шесть, сто двадцать три, девяносто восемь, семьдесят восемь.",
    "bytes": 61066,
    "sha256": "0cc934353d901bae552773648e1e30b2ef84e8b257b2df1db25f7aea51f85e34"
  },
  "r14": {
    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[urgent] [fast]",
    "speed": 1.05,
    "stability": 0.4,
    "text": "Я пассажиром ехал, вышел вместе со всеми.",
    "bytes": 43511,
    "sha256": "5459de6ff7c6c1257f62042360dd524088857dfd28829fd4cb760ce31b18e071"
  },
  "r15": {
    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[urgent] [fast]",
    "speed": 1.05,
    "stability": 0.4,
    "text": "Что? Повторите, тут шумно, дорога рядом!",
    "bytes": 38078,
    "sha256": "7faf9b470c652f8da11fc9a3954ef9f7b68dc8e4887b1d905f99486ce661d6e9"
  },
  "r16": {
    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[urgent] [fast]",
    "speed": 1.05,
    "stability": 0.4,
    "text": "Не знаю я. Людей подальше отвести?",
    "bytes": 40586,
    "sha256": "9329fd337cc48a6bc896ce8c28ab94e94ec8c826b0039aaf603aa94060884636"
  }
}
