{
  "opening": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Здравствуйте... тут мужчину электричка сбила. На переходе через пути. Он лежит, к нему подойти можно.",
    "bytes": 90323,
    "sha256": "5417bb29c0b76a92e80c00d13b6adf076f953beac4b0f9a6388707cd4b8e0350"
  },
  "r1": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Мужчину сбила электричка. Он на переходе был, через пути шёл.",
    "bytes": 48527,
    "sha256": "07a71c38b7f18178f77c7537458c5a0a627cd647e2e76aaafaf6447d2d2947c4"
  },
  "r2": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Состав уже остановился. Пострадавший лежит сбоку от путей.",
    "bytes": 50199,
    "sha256": "d11064c1ba9aca503001e081cef7664cb698663c0e15c47c21d51fa00d952429"
  },
  "r3": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Платформа Лианозово. Переход со стороны Лианозовского рынка.",
    "bytes": 51453,
    "sha256": "4e3705a89354897c719a2acfa65eb84c8ef81d47fbb8053426791c9ed4504ef4"
  },
  "r4": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Москва, район Лианозово.",
    "bytes": 26375,
    "sha256": "a711baae643cf00b058b8d9da7af87292e9ddd3d30ce3ae8a3e60693690b43b8"
  },
  "r5": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Пострадавший один, мужчина. Доступ к нему есть, он не под вагоном.",
    "bytes": 58140,
    "sha256": "734590dd78b685d592885890b9ad950648ebd7841a50518f1074b2cee6a0e437"
  },
  "r6": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Стонет, значит, живой. Нога вывернута, на голове кровь.",
    "bytes": 46437,
    "sha256": "f0c73327286cd9d41d9935b8f65995d3e7d411789079211b33585f03b37b78db"
  },
  "r7": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "По соседнему пути поезда идут. Люди на пути выходят, их отгоняют.",
    "bytes": 60648,
    "sha256": "8f5ddf39c39cb4f26c21c9dd82a8cc07af1075e4d79a99d1fda806873d034abd"
  },
  "r8": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Пострадавший один. Вокруг человек двадцать собралось.",
    "bytes": 44765,
    "sha256": "279e33f858583e1bd80eb992ee8423a16994e738831c9f3ae9d1c5cbe36d033e"
  },
  "r9": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Минуты две назад. Я на платформе стояла, всё видела.",
    "bytes": 48527,
    "sha256": "71611ffdfcce2f2c731ccef8d8222ed0c6fddcb40d2fb451a54d98775ab8be67"
  },
  "r10": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Иванова Елена Сергеевна.",
    "bytes": 24285,
    "sha256": "63284e2b552c57354a65bfa03f592928b7aa6911b6863886c4fbea50e67078bb"
  },
  "r11": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Девять один шесть, восемьсот девяносто шесть, тридцать два, пятьдесят четыре.",
    "bytes": 67335,
    "sha256": "9ad6e966c5be60d8fdec477b354afef168ef93ec5fcc9607caa7cf82b0503735"
  },
  "r12": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Я очевидец. Не знаю его, просто рядом была.",
    "bytes": 38078,
    "sha256": "6b346bef6ba1bde7df3cacf4676fe359057663daf87f8ded2bc673d1a5285094"
  },
  "r13": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Это платформа, подъездов нет. Заход со стороны рынка.",
    "bytes": 44765,
    "sha256": "9466fd2e8cc3f53b39f9a8ba547961e6418e599d8a6812fa557a8e0b73c35509"
  },
  "r14": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Повторите, пожалуйста, тут объявления и люди кричат.",
    "bytes": 46437,
    "sha256": "aa12f50c4e5542a914beda12d46737122e66760d9bb36f65898b6e3d4d9c0ed9"
  },
  "r15": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Не знаю. Мы его не трогаем, стоим рядом.",
    "bytes": 34316,
    "sha256": "9f5e178135901ffa6badf8ff380f96e150f71980c6817e848112fe796cf787a2"
  }
