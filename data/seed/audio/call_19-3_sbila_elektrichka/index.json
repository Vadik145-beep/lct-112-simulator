    "sha256": "cfaaa9306af04f57a038331793c019b435c603c9b6caa9198af570ba9a0a60b6"
  },
  "r10": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[shaky voice] [nervous]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Иванова Елена Сергеевна.",
    "bytes": 31808,
    "sha256": "04264f4703dcd5ab6a188b5677fd8db7befaefdaf93327a41d6209e18730d063"
  },
  "r11": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[shaky voice] [nervous]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Девять один шесть, восемьсот девяносто шесть, тридцать два, пятьдесят четыре.",
    "bytes": 81546,
    "sha256": "63eb362ec18afb684fe69144adb9152cea8ef3cd895031f7fd2f08e8f681f59e"
  },
  "r12": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[shaky voice] [nervous]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Я очевидец. Не знаю его, просто рядом была.",
    "bytes": 52288,
    "sha256": "60ac98efa1a23737e3c781deaed23feabfb0719301ffce9ab9c5756c2d8130a0"
  },
  "r13": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[shaky voice] [nervous]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Это платформа, подъездов нет. Заход со стороны рынка.",
    "bytes": 63991,
    "sha256": "03efa114a2dd3f658412affc60b4a03e6643657d68c4f9ed717606c49fb790fb"
  },
  "r14": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[shaky voice] [nervous]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Повторите, пожалуйста, тут объявления и люди кричат.",
    "bytes": 58558,
    "sha256": "9ddbd410a7d91e4994259ce336d2e2f6030ca15b002a09615848a6b0ae146b17"
  },
  "r15": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
