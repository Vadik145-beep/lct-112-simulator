{
  "opening": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Здравствуйте. На МКАД среди бела дня горит всё уличное освещение. И по внутренней стороне, и по внешней, на несколько километров.",
    "bytes": 119998,
    "sha256": "f768dba7cd96eb0d127c0202362e2c3a6c55ef430d047baa1753e5feb0dd62ce"
  },
  "r1": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Уличное освещение горит днём. На МКАД, все фонари подряд.",
    "bytes": 49363,
    "sha256": "1a941272d295679ad88aab7dc44fe20959c514ff730cf543eb3831ad17ec56b9"
  },
  "r2": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "И по внутренней стороне, и по внешней. Не один столб, а целый участок.",
    "bytes": 66499,
    "sha256": "66c42fd1d27c1f0acd36d5af18d57ee26ec0ac7ac45b2a6a4e644aec83ad6ed2"
  },
  "r3": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "От Ленинградского шоссе до Волоколамского. По столбам это между семьдесят четвёртым и шестьдесят восьмым километром.",
    "bytes": 114146,
    "sha256": "58807f4b2c82fe76a1dbd6692ae722a79c571c359675df0af9c1cd2f81f91061"
  },
  "r4": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Москва, Северное Тушино.",
    "bytes": 25539,
    "sha256": "11d2700c1e88e9daa66585225f21dec1ccd789a020f224842a82819a5d7166fb"
  },
  "r5": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Пострадавших нет. Это не авария, просто свет горит.",
    "bytes": 51035,
    "sha256": "4c478d895b4424b6d26b85ff048e766e94368879b3d56e55f25c534f0869f96f"
  },
  "r6": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Угрозы никакой. Ни искр, ни дыма, фонари целые.",
    "bytes": 47273,
    "sha256": "3c12bec1e5d1331a3c8e57624a0ca2cab3d5e1e8e65645765f675b7615a8e98f"
  },
  "r7": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Людей это не касается. Я просто мимо еду и вижу.",
    "bytes": 43511,
    "sha256": "2fcd2d0742c81cf726d5861e680a5756e9f7539bb244a23ee156d419e30bb0dd"
  },
  "r8": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Сейчас день, светло. Горит всё время, пока я этот участок проезжаю.",
    "bytes": 67335,
    "sha256": "56b51f1b8452016ee3e0906a5fa0eb6a28f501220f6d188ce8126eeb5586d567"
  },
  "r9": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Зотова Алина Петровна.",
    "bytes": 22613,
    "sha256": "0ddd98774f94d5d7d8fce306ebbfcd2588673895f7c305d1769ed5b2c06ebeee"
  },
  "r10": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Девять один шесть, триста двадцать, двенадцать, восемьдесят три.",
    "bytes": 59812,
    "sha256": "ec55588207b0192f9f91e8096ed14a78df9628899f30e55c96b517694a6472d4"
  },
  "r11": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Я очевидец. Просто водитель, еду по МКАД.",
    "bytes": 38914,
    "sha256": "8674c54b448d375f850b080afda84bd3f0e150110bf4370f4de6e0ff25f15f55"
  },
  "r12": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Это МКАД, подъездов нет.",
    "bytes": 24703,
    "sha256": "367239de0bddb943833c78b21500f4f51b6346c83670a207091a4430ce36bec9"
  },
  "r13": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Повторите, пожалуйста, я за рулём.",
    "bytes": 29301,
    "sha256": "938e67d4c227666c26cf2588082efde651d81ff9360fb529a84f048979b4a63b"
  },
  "r14": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Не знаю. Могу номер ближайшего столба посмотреть, если нужно.",
    "bytes": 51453,
    "sha256": "b5ffa5a72e1a33a9aa8d58d2353032eb92774e54508877767074f1e79f11233d"
  }
}
