    "sha256": "be3ca97165a74e55fbd80dda2eea48d0755f2e66",
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_v3",
    "tag": "[panicked] [shaky voice]",
    "text": "Муж мой, Титов Александр Петрович, десятого августа семьдесят седьмого года. Дышит, но с хрипом.",
    "bytes": 131701
  },
  "r5-v2": {
    "sha256": "aeedf34b6e0ca53bb0e54143c21bf492804d9f65",
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_v3",
    "tag": "[panicked] [shaky voice]",
    "text": "Титов Александр Петрович, семьдесят седьмого года рождения, десятое августа. Он дышит, хрипит только.",
    "bytes": 119998
  },
  "r6": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_v3",
    "tag": "[panicked] [shaky voice]",
    "text": "Титова я, жена его.",
    "bytes": 31808,
    "sha256": "d66ca5602ac15002e6c5dcf64422dee545121981"
  },
  "r6-v1": {
    "sha256": "5cd91a2e12cb2e56f3ac833ba0fa036f0853d4b5",
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_v3",
    "tag": "[panicked] [shaky voice]",
    "text": "Титова, жена. Я его жена.",
    "bytes": 48527
  },
  "r6-v2": {
    "sha256": "0c99eece03238b6da27b84ddef0ddcb23c159611",
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_v3",
    "tag": "[panicked] [shaky voice]",
    "text": "Я Титова, жена его.",
    "bytes": 34316
  },
  "r7": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_v3",
    "tag": "[panicked] [shaky voice]",
    "text": "Девять шестнадцать, восемьсот девяносто шесть, тридцать два, пятьдесят четыре.",
    "bytes": 65245,
    "sha256": "2005cd2fdc04ab59f15f9033b78a6a18b79f4baa"
  },
  "r7-v1": {
    "sha256": "53f4b844d528eed54109c3000cfbedcdd0ba4c05",
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_v3",
    "tag": "[panicked] [shaky voice]",
    "text": "Девятьсот шестнадцать, восемьсот девяносто шесть, тридцать два, пятьдесят четыре.",
    "bytes": 69007
  },
  "r7-v2": {
    "sha256": "675667200a92ecb5dd738159ad4a1c63347924a9",
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_v3",
    "tag": "[panicked] [shaky voice]",
    "text": "Девять один шесть, восемь девять шесть, три два, пять четыре.",
    "bytes": 72768
  },
