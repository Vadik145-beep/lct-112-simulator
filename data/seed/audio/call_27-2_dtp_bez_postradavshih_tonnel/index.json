    "sha256": "682a7ffe27da7b6dd21fe734b38f9866d85035e2efa2176b4befcc483faa1d89"
  },
  "r16": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_v3",
    "tag": "[calm]",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Не знаю. Нам за тоннель откатиться или тут ждать?",
