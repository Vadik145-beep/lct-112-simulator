    "model": "eleven_v3",
    "tag": "[urgent] [fast]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Сын упал с велосипеда. Сам упал, на повороте занесло.",
    "bytes": 63991,
    "sha256": "cf909b9ade1bd10fb301e43d591ff971d04ae7cbe92d5fe292cc89a5bf29e017"
