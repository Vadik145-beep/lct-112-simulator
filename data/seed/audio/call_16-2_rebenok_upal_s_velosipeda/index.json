    "sha256": "173628c9617d50ac49058ba387c028f7f8d3031d825cec06bfc5eb48d5d56d20"
  },
  "r6": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[urgent] [fast]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "В сознании, плачет. Головой не ударялся, был в шлеме.",
    "bytes": 54796,
    "sha256": "31646530e38793af8e6ad2875bd1bc5696d835884816bfc849a56f86f8851f56"
