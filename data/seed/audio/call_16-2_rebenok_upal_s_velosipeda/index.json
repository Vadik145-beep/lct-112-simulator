    "model": "eleven_v3",
    "tag": "[urgent] [fast]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Улица Карла Маркса, около молсыркомбината. На тротуаре сидим.",
    "bytes": 69007,
    "sha256": "4484462e224cc539d493bfb65550255014d55567f9c5e668aca1379bfb31169a"
  },
