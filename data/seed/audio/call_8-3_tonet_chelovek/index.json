{
  "opening": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[shaky voice] [nervous]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Человек тонет! Прямо сейчас, на озере! Мужчина, он кричит, помогите, скорее!",
    "bytes": 106205,
    "sha256": "80598d1e2763cb45157d73495f7555e19ad2e830ad749a1d6ca340e23265741a"
  },
  "r1": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[shaky voice] [nervous]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Мужчина тонет! Он в воде, то уйдёт, то вынырнет.",
    "bytes": 74022,
    "sha256": "4975de2d934228e0302df4e77a7812e481c6884a6746dab3f9ff5f2595ba2ed5"
  },
  "r2": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[shaky voice] [nervous]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Господи, он опять под воду ушёл! Вынырнул, кричит!",
    "bytes": 65245,
    "sha256": "7d007fbffe0be59145e8dad99de9f174885d5b761e4b5e7479791908d47ace68"
  },
  "r3": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[shaky voice] [nervous]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Озеро Круглое, пляж. Рядом дом — Таманская улица, дом семьдесят пять, корпус два.",
    "bytes": 107459,
    "sha256": "76d03ec92c2d8a523feab2812057dfeaa0a3770425bca6422571ea4d5bb2eab5"
  },
  "r4": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[shaky voice] [nervous]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Москва, Хорошёво-Мнёвники.",
    "bytes": 41839,
    "sha256": "e59d9282efb6924dbb6a2e44f486f8818867dc3e649d6b6955be0fd006fa5244"
  },
  "r5": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[shaky voice] [nervous]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "В воде он один. Пока держится, голову видно.",
    "bytes": 58558,
    "sha256": "2df069aec2a06b17b24ce337e5c3c57e97956056b9dc39c0266c43a74180fca4"
  },
  "r6": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[shaky voice] [nervous]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "От берега метров двадцать. Спасателей тут нет, будки закрыты.",
    "bytes": 62319,
    "sha256": "6ef5688bdf8be1d9151c9ba0a85d679cdcdc03c120d655665e92b057a6c04fab"
  },
  "r7": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[shaky voice] [nervous]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "На берегу человек десять. В воду никто не идёт.",
    "bytes": 62319,
    "sha256": "25121e91c32235fa3f2b72067dfaa6def68abaa0957c54bd95c0db4fb7dc7d51"
  },
  "r8": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[shaky voice] [nervous]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Минуту назад начал тонуть. Сразу звоню.",
    "bytes": 47273,
    "sha256": "1d579285c406c42ced3c3c7ac5c852902e2a41b8c142906436996b18c2db4fa3"
  },
  "r9": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[shaky voice] [nervous]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Иванова Елена Сергеевна.",
    "bytes": 31808,
    "sha256": "379c7fca5d0a29a5680831aa4ba2a550042022172d1c6aef055ac98896164d8a"
  },
  "r10": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[shaky voice] [nervous]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Девять один шесть, восемьсот девяносто шесть, тридцать два, пятьдесят четыре.",
    "bytes": 86979,
    "sha256": "3932b8425e02e11908236390e77a31a1f60f1c91b5739fb40e8a7dd8c8773d05"
  },
  "r11": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[shaky voice] [nervous]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Я очевидец. На пляже была, не родственница ему.",
    "bytes": 56050,
    "sha256": "25386aa4fc6dd7a1063479eec88541af9b3900682d6144bd1f34fd34ae992f09"
  },
  "r12": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[shaky voice] [nervous]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Это пляж, подъездов нет. Заход со стороны Таманской.",
    "bytes": 74022,
    "sha256": "8411101dbcbfa8bef4c23efbfcb8f4851e887aef302e5f3aa4bf30bf74d83b85"
  },
  "r13": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[shaky voice] [nervous]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Что? Повторите, я на воду смотрю!",
    "bytes": 49781,
    "sha256": "18ee6dd9f92dcb63fd5d549bbfc62cdab25108d148ca17b2eedcf51160e9abbf"
  },
  "r14": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[shaky voice] [nervous]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Не знаю! Мужчины тут круг ищут, найти не могут!",
    "bytes": 67753,
    "sha256": "276fa7b1be609b6e8a045bf9e493eb775ac3107ab56ac811d06388a9f83e5478"
  }
}
