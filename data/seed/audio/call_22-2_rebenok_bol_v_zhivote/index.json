{
  "opening": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Здравствуйте, сыну четыре года, живот болит сильно. И рвота с кровью была, прямо в машине. Мы в дороге.",
    "bytes": 100772,
    "sha256": "5a589cb4b736e0ab22c627e68d442a4c3ae4813c89172acdb0bb24b61fdd044c"
  },
  "r1": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "У сына живот болит. Сильно, он согнулся и кричит.",
    "bytes": 58976,
    "sha256": "3990d43c8e0e3dfa39da54ab1e82870de47068954af6bd6cca56abc6f5b1ca03"
  },
  "r2": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Рвота была с кровью. Два раза уже, прямо в машине.",
    "bytes": 51453,
    "sha256": "49c30d23e4a13c49ba75fd5ac6b01fe3e7511d567abaede8ae1b92aa9462fcd1"
  },
  "r3": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Мы не в Москве. Тверская область, у Ржева.",
    "bytes": 47691,
    "sha256": "7fddfe92abba7d295c1cdccf889ef853ca7845e386021f8434a11bec7df0a289"
  },
  "r4": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Стоим на Ленинградском шоссе, около памятника Ленину, напротив вокзала Ржев-один.",
    "bytes": 91577,
    "sha256": "d3df78209ac4b48ce5debec942cecd5e77628cd50ccef3e7134b86da7418b83b"
  },
  "r5": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Ехали из Зубцова в сторону Селижарова, встали на обочине.",
    "bytes": 55214,
    "sha256": "a54a71cff9340a7bc51a73c40d258794eaaf803921fa25a391c1b64d66b98054"
  },
  "r6": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Ребёнок один, сын. Соловьёв Максим, четыре года.",
    "bytes": 52288,
    "sha256": "a09c711b26faf8fce111e8e34e199e527394ea7dd567d00e51e61fdc4dc25e89"
  },
  "r7": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "В сознании, плачет. Бледный весь, лоб холодный.",
    "bytes": 53124,
    "sha256": "6af7dd7d6b3b623f67e5175c5a95e698e0f0c04d575943a2d508cb5bb6fa87a0"
  },
  "r8": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Кровь в рвоте — вот это меня и пугает. Больше ничего не ел.",
    "bytes": 68589,
    "sha256": "e5a67c76553e3bac8d9b70aed168dc3340f4f76d957e36d491b52befb9e2ee3c"
  },
  "r9": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Мазда шесть, белая. Номер один три два пять ноль эр, регион сто девяносто семь.",
    "bytes": 92413,
    "sha256": "d51cfa30b7091cfbffa198bf9db6ee30ac4d844fb9d9433a85d5cdfba84087c8"
  },
  "r10": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "В машине мы втроём. Я, жена и сын.",
    "bytes": 38078,
    "sha256": "94fb93f8223178aa3158c3e9583c89b7a35031ccc55d05febc6ef1f15e2ff915"
  },
  "r11": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Живот минут сорок болит. Рвота началась минут двадцать назад.",
    "bytes": 58976,
    "sha256": "18bea954cf6248e017366ccb4ade2d6686fbe2049759267909d27dff40a2da37"
  },
  "r12": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Соловьёв, я отец. Вызываю сыну.",
    "bytes": 42675,
    "sha256": "b2830938d25da4b84743218977bcc9db09b886f5a2b37fccbf09e191caebbf12"
  },
  "r13": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Девять один шесть, восемьсот девяносто шесть, тридцать два, пятьдесят четыре.",
    "bytes": 73186,
    "sha256": "1a891189bb6c2b4be1758c1007cff29e99d43f1aed22d6379f821d92841d3c8c"
  },
  "r14": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Я папа. За рулём был, сейчас рядом с ним.",
    "bytes": 50199,
    "sha256": "9a001a85c258a35e28649fc75a25acde738c9b3ada0ce68b16ae059b002ae292"
  },
  "r15": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Повторите, пожалуйста, он плачет громко.",
    "bytes": 35152,
    "sha256": "64a44ee195de0f24336dbb2aab1f2808049d502342b14a79afd95cf545e9f1cc"
  },
  "r16": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Не знаю. Нам ехать в больницу самим или ждать?",
    "bytes": 53124,
    "sha256": "b41ee3dccd6250153632c2c1bb9e95623b551a31dd04c33b0b355d2feb8e3aed"
  }
}
