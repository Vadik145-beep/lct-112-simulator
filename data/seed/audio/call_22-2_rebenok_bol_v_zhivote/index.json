    "model": "eleven_v3",
    "tag": "[anxious] [fast]",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Ехали из Зубцова в сторону Селижарова, встали на обочине.",
    "bytes": 49781,
    "sha256": "2fe70db5415396a3d723967c2a8b59bda290ebcb63e7ecf7063e4907043782fa"
  },
  "r6": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_v3",
    "tag": "[anxious] [fast]",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Ребёнок один, сын. Соловьёв Максим, четыре года.",
