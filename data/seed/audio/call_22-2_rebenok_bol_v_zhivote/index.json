    "sha256": "0dba7135b0be10ed991ab0452ff7ba6aeefd0c7286f0dcc79e39cf545ff5b355"
  },
  "r8": {
    "voice_id": "drOVtcvHhJKNEXv5h1l5",
    "model": "eleven_v3",
    "tag": "[anxious] [fast]",
    "speed": 1.1,
    "stability": 0.4,
    "text": "Кровь в рвоте — вот это меня и пугает. Больше ничего не ел.",
