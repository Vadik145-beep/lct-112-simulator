    "sha256": "ea78af3fe85db8591d0003024c2f3545630d4e2d",
    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[calm]",
    "text": "Наряд один, восемь, ноль, семь, он и выезжает.",
    "bytes": 43510
  },
