  "1c6b663d": {
    "sha256": "4ef656351ceea6e41433f672738b35d5df766866",
    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[calm]",
    "text": "Начальник аварийной бригады Гормоста, слушаю. Карточку от вас уже принял. Бригаду собираем, выезжаем. Как выедем — доложу.",
    "bytes": 114981
  },
  "1c7bc6c2": {
    "sha256": "53b783f58ab1bcd065b1f09c0f9ec1e0e0738826",
    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[calm]",
    "text": "Начальник аварийной бригады Гормоста, слушаю. Карточку от вас уже принял. Я вам звонил, вы не взяли. Бригада в пути, едем на адрес. По прибытии доложим.",
    "bytes": 145910
  },
  "1d27906e": {
    "sha256": "e7ef87e90b6fd91c3db980ad51fa6e93cccc8f8a",
    "voice_id": "4R4ha50vLnNdjMQDY20a",
    "model": "eleven_v3",
    "tag": "[calm]",
    "text": "Информацию принял, бригаду направляю.",
    "bytes": 39332
  },
  "2d44c18b": {
    "sha256": "e0f2312b7a1ce2a9f35df55c8e627190b07c5d92",
    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[calm]",
    "text": "Бригаду собираем, выезжаем. Как выедем — доложу.",
    "bytes": 46018
  },
  "2e30ed8e": {
    "sha256": "7f686e49169d5443c8633e8b5c22e20a1259d1cb",
    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[calm]",
    "text": "Бригада на месте, осматриваемся. Как начнём работы — доложу.",
    "bytes": 59811
  },
  "2f51cba1": {
    "sha256": "356ead4d6b0b2dc4237ca920f905d3bda6ca7bda",
    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[calm]",
    "text": "Принято. Как будем на месте, доложу.",
    "bytes": 39331
  },
