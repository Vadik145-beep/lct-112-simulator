    "voice_id": "3EuKHIEZbSzrHGNmdYsx",
    "model": "eleven_v3",
    "tag": "[calm]",
    "text": "Принял, аварийная бригада Мосгаза выезжает, до прибытия не включать свет.",
    "bytes": 61065
  },
  "2a1a2ec5": {
