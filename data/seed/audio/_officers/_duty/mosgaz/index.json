    "sha256": "05a7a521f4ed263db22e61b40bbc66fc2842c264",
    "voice_id": "Ub7uk2SbJdkjKWYvlnLN",
    "model": "eleven_v3",
    "tag": "[calm]",
    "text": "Повторите, пожалуйста, плохо слышно.",
    "bytes": 30554
  },
  "7480c6b2": {
    "sha256": "d7fc1981379d81efbc1e91596c67fb352e996669",
    "voice_id": "Ub7uk2SbJdkjKWYvlnLN",
    "model": "eleven_v3",
    "tag": "[calm]",
    "text": "Адрес принял. Подъезд, этаж известны?",
    "bytes": 46018
  },
  "9335295f": {
    "sha256": "84b45c6896f9a922088885520d8e6640d1f082d6",
    "voice_id": "Ub7uk2SbJdkjKWYvlnLN",
    "model": "eleven_v3",
    "tag": "[calm]",
    "text": "Отрабатываем своими силами.",
    "bytes": 36823
  },
