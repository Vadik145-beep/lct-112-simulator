    "sha256": "3300e86fbfa1c9d248dbb4b7eae25f34e4a5335f",
    "voice_id": "Ub7uk2SbJdkjKWYvlnLN",
    "model": "eleven_v3",
    "tag": "[calm]",
    "text": "Понял, доступ есть.",
