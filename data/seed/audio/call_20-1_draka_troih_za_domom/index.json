{
  "opening": {
    "voice_id": "4R4ha50vLnNdjMQDY20a",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Здравствуйте. За домом трое дерутся. Оружия не вижу, но машут крепко.",
    "bytes": 67335,
    "sha256": "d5e9dc26ada1cd88258a6dd1003377455d7f9cb875ce0b8b20ae151162267450"
  },
  "r1": {
    "voice_id": "4R4ha50vLnNdjMQDY20a",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Трое мужчин дерутся. Толкаются, кулаками машут.",
    "bytes": 41839,
    "sha256": "2abb8d80d4499d558be285997598838ff3aa22c7b36064541c4930ef55d306fe"
  },
  "r2": {
    "voice_id": "4R4ha50vLnNdjMQDY20a",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Началось с крика, потом сцепились. Никто не разнимает.",
    "bytes": 44765,
    "sha256": "0ca5eaab0bb349db8f1bd173bb1b53c601ecab1ce8c14025c4fd0d10dc13679b"
  },
  "r3": {
    "voice_id": "4R4ha50vLnNdjMQDY20a",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Олонецкий проезд, дом четыре. Это за домом, на дорожке.",
    "bytes": 47273,
    "sha256": "a6cb94d1d8ff8c841dac38c2f46e3a3ab0f4d60075d946e36e6956bc0939881e"
  },
  "r4": {
    "voice_id": "4R4ha50vLnNdjMQDY20a",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Дорожка в сторону кладбища идёт. От подъездов метров пятьдесят.",
    "bytes": 54378,
    "sha256": "08c14ad8dab950b68570b2e95108533d5df07797d3e845a4725e4f2d5e18d007"
  },
  "r5": {
    "voice_id": "4R4ha50vLnNdjMQDY20a",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Москва, Бабушкинский район.",
    "bytes": 25539,
    "sha256": "1c6765f40a3ecd0ab7275f38ebd442a5f13d0101f9401969e2083bd1b13f247f"
  },
  "r6": {
    "voice_id": "4R4ha50vLnNdjMQDY20a",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Пострадавших нет. Все трое на ногах, крови не вижу.",
    "bytes": 47273,
    "sha256": "9cf08c7d29032b3bac8ecfd981e7d90b608b5200c94ba9663f413e243775ee4e"
  },
  "r7": {
    "voice_id": "4R4ha50vLnNdjMQDY20a",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Оружия нет. Ни палок, ни ножей, руками дерутся.",
    "bytes": 47273,
    "sha256": "b59eef0de75176b02d5d222c71917ed4f75ade73a499dd43c267146572b32683"
  },
  "r8": {
    "voice_id": "4R4ha50vLnNdjMQDY20a",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Трое. Ещё двое стоят в стороне, смотрят.",
    "bytes": 35152,
    "sha256": "1cc30bb352caeca790e381d3445221c0ae986acf6a2b4dd994afe4d276141a39"
  },
  "r9": {
    "voice_id": "4R4ha50vLnNdjMQDY20a",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Минуты две назад началось. Я сразу позвонил.",
    "bytes": 41839,
    "sha256": "94a2247e9a921e7f2d746996773dfabe683ad5a7377a7c0f63a7f406c8fb6adc"
  },
  "r10": {
    "voice_id": "4R4ha50vLnNdjMQDY20a",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Иванов Сергей Петрович.",
    "bytes": 21777,
    "sha256": "ee5c2f0860eec218e32e2285cf63db71f35538884387484e73c081d857a517a2"
  },
  "r11": {
    "voice_id": "4R4ha50vLnNdjMQDY20a",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Девять один шесть, сто двадцать три, девяносто восемь, семьдесят восемь.",
    "bytes": 62737,
    "sha256": "ed075ce177b4c7f46a8febfe7de680383e76dc541beba1b1ef9ff25b5ecdaa38"
  },
  "r12": {
    "voice_id": "4R4ha50vLnNdjMQDY20a",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Очевидец я. Мимо шёл, увидел.",
    "bytes": 25539,
    "sha256": "d96c699883642b9d7dc17137e136f86f2060e5211e4fb057212440498fadbf72"
  },
  "r13": {
    "voice_id": "4R4ha50vLnNdjMQDY20a",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Это на улице, за домом. Подъезда нет.",
    "bytes": 33062,
    "sha256": "9362c1a21d1880eff6a9f5ac97277905a4fc45591340dbe88178c6110b888e44"
  },
  "r14": {
    "voice_id": "4R4ha50vLnNdjMQDY20a",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Повторите, пожалуйста, не расслышал.",
    "bytes": 30973,
    "sha256": "ad28f6bba49c6d003ab63cfb85e808bdb41035ca9de45c1405020fbcdab31fd2"
  },
  "r15": {
    "voice_id": "4R4ha50vLnNdjMQDY20a",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Не знаю. Могу подождать наряд, я недалеко стою.",
    "bytes": 40586,
    "sha256": "eca07c7150a8c2c7dcbfe18f247f7d1a93dd91c441a7c962fe55599e7612793a"
  }
}
