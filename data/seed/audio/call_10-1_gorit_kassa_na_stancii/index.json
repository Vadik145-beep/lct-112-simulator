    "sha256": "339358ba0b14818c833ca813b294cc92884fad63e7140072884122d0e025adc5"
  },
  "r14": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Это станция, платформа. Подъездов нет.",
