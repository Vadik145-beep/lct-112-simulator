    "sha256": "16406a15f8a690505bab1afeb5c666fab72356dd35e8b7b70b63faad219cdd9f"
  },
  "r8": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Дым на платформу тянет, а тут людей полно, электричку ждут.",
    "bytes": 51453,
    "sha256": "a4face1401be301e5599c2b9131d17b5f7a66bb334c7d2f41629411f99a1ab4c"
  },
  "r9": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "В кассе была она одна. На платформе человек тридцать.",
    "bytes": 44347,
    "sha256": "7be56a42e5c56490589cb6f22a80b12d649d9ce0c39d84261afe9077b41632e1"
  },
  "r10": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Минуты три назад вспыхнуло. Сначала дым пошёл, потом пламя.",
