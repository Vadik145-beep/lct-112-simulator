    "sha256": "0ef956d3d9a8a3022df05dff16594e0feb23050847e3d3571a73d3cb7cb267c8"
  },
  "r11": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Беликова Юлия Викторовна. Я очевидец.",
    "bytes": 31391,
    "sha256": "12fc04603d7021c086016f6a876f5a14d4f2e54305d08ffe01df51bdad1db3ec"
  },
  "r12": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Девять один шесть, сто двадцать три, девяносто восемь, семьдесят восемь.",
    "bytes": 58976,
    "sha256": "5320fbcfbfd8b4198a0dc3f7224cc87c91005d42033d5a2add1c6d8972c75e85"
  },
  "r13": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Я пассажирка, электричку ждала. С кассиром не знакома.",
