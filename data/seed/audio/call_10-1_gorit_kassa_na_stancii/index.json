    "sha256": "59a113c217395067a87eae86083e787580a6ffa4f43d8120ec218e243de6179b"
  },
  "r6": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Одна пострадавшая, кассир. Ожог лица и рук, но в сознании.",
    "bytes": 48527,
    "sha256": "1e4cd79ffeb406b02cccbaa458405c3a3056f395a128df1e65091eb7d7a54fed"
  },
  "r7": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Назвалась Гвоздикова Анна Павловна, сорок пять лет.",
