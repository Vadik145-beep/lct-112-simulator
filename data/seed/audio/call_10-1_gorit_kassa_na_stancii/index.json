    "sha256": "bf05d6b856e7b996f002dd47ba7116451ac46c22dff0dcd3f2daf955738e23da"
  },
  "r12": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[shaky voice] [nervous]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Девять один шесть, сто двадцать три, девяносто восемь, семьдесят восемь.",
