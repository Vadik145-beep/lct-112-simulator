    "sha256": "5b17808cf44a8ee1b1fd35f7982a81fbcf46b070413b48b8cdd9739e5a5f234d"
  },
  "r15": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Что? Тут объявления по громкой, повторите!",
