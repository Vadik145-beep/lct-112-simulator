    "sha256": "0026e2ae3f4292f35df78d7fd2a2384872a37865833f4d0be58551f56d6e04cb"
  },
  "r6": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_v3",
    "tag": "[shaky voice] [nervous]",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Одна пострадавшая, кассир. Ожог лица и рук, но в сознании.",
