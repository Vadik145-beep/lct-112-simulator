  },
  "r1": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_v3",
    "tag": "[anxious] [fast]",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Машины столкнулись, а водители теперь дерутся. Прямо посреди дороги.",
    "bytes": 79038,
    "sha256": "d3413207326a28852b2cfcef3b5f4cc00d7e414111c5c314483bb41e5a3fac42"
