    "model": "eleven_v3",
    "tag": "[anxious] [fast]",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Пострадавших от аварии нет. Оба вышли и сразу за грудки.",
    "bytes": 61066,
    "sha256": "7f01ae090656373bd606e0c6601423a9e98fa7a3ad774254e158c0444f5e5bdf"
  },
