    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Площадь тут Смоленская-Сенная, если по названию.",
    "bytes": 40586,
    "sha256": "9f2318aacda270803fcab38308830e4edf1e8933ec92c9f959e5b980498fee51"
  },
  "r5": {
