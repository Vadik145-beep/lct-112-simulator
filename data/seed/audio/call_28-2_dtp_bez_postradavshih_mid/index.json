  },
  "r1": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_flash_v2_5",
    "speed": 1.0,
    "stability": 0.5,
    "text": "ДТП, две машины. Пежо и фольксваген.",
