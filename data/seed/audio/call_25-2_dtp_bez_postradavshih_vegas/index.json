    "sha256": "dd347d1aa3c39f483fd3123a23211a3fd105951c2f5b5de94f5bf1153030db19"
  },
  "r16": {
    "voice_id": "p6vKV7V6zDIyRuF9f39P",
    "model": "eleven_v3",
    "tag": "[calm]",
    "speed": 1.0,
    "stability": 0.5,
    "text": "Не знаю. Нам разъезжаться или стоять до приезда?",
