{
  "opening": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Пожалуйста, скорее! Сын с горки упал, лицо разбил, кровь идёт!",
    "bytes": 55214,
    "sha256": "553683021121ccc5f9625535259b4648a4e769fc1b252e35d5bf182cf3518573"
  },
  "r1": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Сын с горки упал! Лицом вниз, кровь из носа и губа разбита.",
    "bytes": 58140,
    "sha256": "7d48eb380540d529edd124a8093a49881fb46d227f67f74abbfc377a36c0d64c"
  },
  "r2": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Горка высокая, метра полтора. Сам полез, я не успела подхватить.",
    "bytes": 52288,
    "sha256": "cef235cf74033e5d574f2e8aeb8ccbd8c099177eb0b969b5f601ffb8e628af91"
  },
  "r3": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Погонный проезд, дом один. Мы во дворе, на детской площадке.",
    "bytes": 52288,
    "sha256": "b01d15e740893173cf818c0024e933c7e7a5af608e57be04703f9aaaa81bbf0b"
  },
  "r4": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Корпус четыре. Площадка между домами, её от дороги видно.",
    "bytes": 49363,
    "sha256": "4e9972c83d97db77d80ea835cf296868c3849925737e069a8be3c46e772e851f"
  },
  "r5": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Москва, Богородское.",
    "bytes": 20942,
    "sha256": "aac55e900dfc587e3091ff0e974bbe13d8b689b84fffa0c208699646b1352791"
  },
  "r6": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Сын, Костя. Касанов Константин Константинович, восемь лет.",
    "bytes": 47691,
    "sha256": "b11a87bcd5f1b9d2e1562684f18ee061a24a04652782e1f732da147d5e1560b3"
  },
  "r7": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "В сознании, плачет. Сознание не терял, я рядом была, всё видела.",
    "bytes": 55214,
    "sha256": "1df0ce9ceededa2ef3aa28494a9d154c4ae70d641cf39bd4ff0406ae8d984c10"
  },
  "r8": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Нет, ничего не угрожает. Мы в стороне сидим, я его на лавочку посадила.",
    "bytes": 56050,
    "sha256": "34040f9775bc6c9c1591c006d6643a845382bc4b2c0db804aeb96bdcc141662f"
  },
  "r9": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Он один упал. Других детей на площадке сейчас нет.",
    "bytes": 43511,
    "sha256": "fba0249882224cb042be3a37c1cb78e6ea646ea105a8664001342eaafdfb628c"
  },
  "r10": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Только что, пару минут назад. Кровь салфеткой прижимаю.",
    "bytes": 50199,
    "sha256": "cbaea3193f928c40896e987f86cfb41cfc99b5b14e27e6ae34fd09e66013d132"
  },
  "r11": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Я мама его. Сына зовут Касанов Константин Константинович.",
    "bytes": 51453,
    "sha256": "2c512e96e385ccfaf00960c61e8e0258fbcc619ee7908f1b1331a906c405a9b7"
  },
  "r12": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Девять один шесть, восемьсот девяносто шесть, тридцать два, пятьдесят четыре.",
    "bytes": 68589,
    "sha256": "5896d49a844460675eba944b6d846df1af11f5d8e7ca705186426e7c360b9c82"
  },
  "r13": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Мама я. Мы вдвоём гуляли.",
    "bytes": 30137,
    "sha256": "7b4df1b94710d8abdf247420b9a9e222f8e1af950236dba4d0cbda4fbfb08b5c"
  },
  "r14": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Мы на улице, во дворе. В подъезд не заходили.",
    "bytes": 40586,
    "sha256": "ad9c13d8c821719ec50f7792a6752b718cddbcb5d8e7fdfd89241f29b97bb7b6"
  },
  "r15": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Повторите, пожалуйста, он плачет, я плохо слышу.",
    "bytes": 37660,
    "sha256": "b955e909dbc79ced3cbacfdaaa02100c6fcf990ede37a2338ea46715d8a32cb5"
  },
  "r16": {
    "voice_id": "hfQ4EBmlnMg0YB8G0ItC",
    "model": "eleven_flash_v2_5",
    "speed": 1.1,
    "stability": 0.35,
    "text": "Не знаю я, приезжайте скорее, у него кровь!",
    "bytes": 35988,
    "sha256": "b38e7e281198cefc2f8f0ffb98e19fee79685a8a290ed7974ccbbf707bd5fed1"
  }
}
