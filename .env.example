# Настройки тренажёра оператора ДДС-112.
# Скопируйте в .env и при необходимости поменяйте значения. Файл .env в git не попадает.

# ---------- Общие ----------
# Окружение: development | production. В production выключены подробные ошибки.
APP_ENV=development
# Демо-режим: на экране входа появляются кнопки «Войти как …», демо-пользователи
# входят без смены пароля. На стенде для жюри = true, в бою = false.
DEMO_MODE=true
# Разрешить внешние ИИ-сервисы (только для разработки). На стенде и питче = false.
ALLOW_EXTERNAL_AI=false
# Часовой пояс для интерфейса и отчётов.
TZ=Europe/Moscow

# ---------- Безопасность ----------
# Секрет для подписи JWT. Обязательно поменять: openssl rand -hex 32
SECRET_KEY=change-me-please-0123456789abcdef0123456789abcdef
# Время жизни access-токена (минуты) и refresh-токена (дни).
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Блокировка входа: после LOGIN_MAX_ATTEMPTS неудач на LOGIN_LOCK_MINUTES минут.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Cookie refresh-токена только по HTTPS (за nginx всегда true).
COOKIE_SECURE=true

# ---------- База данных ----------
# Суперпользователь PostgreSQL (владелец схемы, миграции, резервные копии).
POSTGRES_DB=trainer
POSTGRES_USER=trainer
POSTGRES_PASSWORD=trainer-dev-password
# Роль приложения: ограниченные права, в частности нет UPDATE и DELETE на журнал аудита.
APP_DB_USER=trainer_app
APP_DB_PASSWORD=trainer-app-dev-password
# Порт PostgreSQL на хосте (для тестов и инструментов с хоста).
POSTGRES_PORT=5432
# Адреса подключения (внутри compose хост = postgres).
DATABASE_URL=postgresql+asyncpg://trainer_app:trainer-app-dev-password@postgres:5432/trainer
DATABASE_ADMIN_URL=postgresql+asyncpg://trainer:trainer-dev-password@postgres:5432/trainer
# Redis: очередь фоновых задач и события.
REDIS_URL=redis://redis:6379/0
# Порт Redis на хосте.
REDIS_PORT=6379
# Тестовая база (pytest с хоста): создаётся автоматически при первом запуске тестов.
TEST_DATABASE_ADMIN_URL=postgresql+asyncpg://trainer:trainer-dev-password@localhost:5432/trainer_test
TEST_DATABASE_URL=postgresql+asyncpg://trainer_app:trainer-app-dev-password@localhost:5432/trainer_test
TEST_REDIS_URL=redis://localhost:6379/1

# ---------- Демо-пользователи (создаются командой python -m app.seed) ----------
# Пароль для admin, teacher1, teacher2, student1 … student12.
SEED_PASSWORD=Demo12345

# ---------- Сервисы ----------
# LanguageTool (проверка грамотности). Если недоступен, оценка идёт без грамотности.
LANGUAGETOOL_URL=http://languagetool:8010
# Папка данных: organizers/ (файлы организаторов, не в git) и seed/ (производные, в git).
# В контейнерах смонтирована как /data; при запуске из backend/ по умолчанию ../data.
DATA_DIR=/data

# ---------- Локальные модели (профиль ai: docker compose --profile ai up -d) ----------
# Папка с моделями на хосте (scripts/fetch_models.sh), монтируется в контейнеры как /models.
MODELS_DIR=./models
# Режим диалога с заявителем (PRD 9.3): select | hybrid | generate | buttons | live.
# select — модель выбирает утверждённую реплику по номеру (по умолчанию на CPU, стенд).
# Если сервер модели недоступен, любой режим работает как buttons (кнопки тем без модели).
DIALOG_MODE=select
# Адреса сервисов профиля ai. В закрытом контуре только локальные адреса (см. ALLOW_EXTERNAL_AI).
# Пустое значение = запасной вариант без модели.
LLM_DIALOG_URL=http://llm-dialog:8080
LLM_GEN_URL=http://llm-gen:8080
# На машине с 12 ГБ, где 7B не поднять рядом со стеком, генерацию сценариев можно отдать
# модели диалога: LLM_GEN_URL=http://llm-dialog:8080 — тогда LLM_DIALOG_CTX=16384, иначе промпт
# генерации (~2100 токенов + ответ) не помещается в слот и бэкенд уходит в шаблон.
# Качество 3B ниже 7B (docs/PERFORMANCE.md), черновики требуют правки.
STT_URL=http://stt:9000
# Модели llama.cpp (файлы в models/llm): диалог 1.5B или 3B, генерация 7B (две части).
LLM_DIALOG_MODEL=qwen2.5-1.5b-instruct-q4_k_m.gguf
LLM_GEN_MODEL=qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf
# Контекст и число слотов (одновременных разговоров) сервера диалога; потоки CPU на сервер.
LLM_DIALOG_CTX=8192
LLM_DIALOG_SLOTS=4
LLM_GEN_CTX=8192
LLM_THREADS=4
# Как llama.cpp читает файл модели: auto (mmap) на Linux; mlock на Docker Desktop под Windows,
# где чтение модели через смонтированную папку по mmap занимает десятки минут.
LLM_LOAD_MODE=auto
# Распознавание речи: faster-whisper-base (быстрее) или faster-whisper-small (точнее).
STT_MODEL=faster-whisper-base
STT_COMPUTE_TYPE=int8
# Папка внутри контейнера stt для записей, в которых речь не распознана (пусто = не хранить).
STT_DUMP_DIR=
# Детектор речи в звонке: models/vad/silero_vad.onnx (в манифесте); без файла — по громкости.
# Порты сервисов ai на хосте (для scripts/bench_dialog_latency.py).
LLM_DIALOG_PORT=8081
LLM_GEN_PORT=8082
STT_PORT=9000
# Папка модели эмбеддингов (multilingual-e5-small, ONNX). Нет папки — TF-IDF без модели.
EMBEDDING_MODEL_DIR=/models/embeddings/multilingual-e5-small
# Порты nginx на хосте.
HTTP_PORT=80
HTTPS_PORT=443
# Имя хоста в сертификате TLS (через запятую можно несколько).
TLS_HOSTS=localhost,127.0.0.1

# ---------- Телефония (профиль telephony: docker compose --profile telephony up -d) ----------
# Включить звонки через Asterisk. false = панель вызова работает через микрофон браузера.
TELEPHONY_ENABLED=false
# Пароль пользователя ARI (бэкенд ↔ Asterisk). Поменять на стенде.
ARI_PASSWORD=trainer
# Адрес машины, который Asterisk сообщает софтфону для звука. Обязателен на Docker Desktop
# (Windows, macOS): адрес контейнера из браузера недоступен. На Linux можно оставить пустым.
TELEPHONY_EXTERNAL_IP=
# Сеть контейнеров (адреса из неё считаются локальными).
TELEPHONY_LOCAL_NET=172.16.0.0/12
# Диапазон портов RTP (публикуется наружу как есть) и порты SIP и ARI на хосте.
TELEPHONY_RTP_START=10000
TELEPHONY_RTP_END=10100
SIP_PORT=5060
ARI_PORT=8088

# ---------- Резервные копии ----------
# Время ежедневной копии (часы:минуты по TZ) и сколько последних копий хранить.
BACKUP_TIME=03:00
BACKUP_KEEP=14

# ---------- Журналирование ----------
# Уровень логов: DEBUG | INFO | WARNING | ERROR. Формат всегда JSON.
LOG_LEVEL=INFO
