# Настройки тренажёра оператора ДДС-112.
# Скопируйте в .env и при необходимости поменяйте значения. Файл .env в git не попадает.

# ---------- Общие ----------
# Окружение: development | production. В production выключены подробные ошибки.
APP_ENV=development
# Демо-режим: на экране входа появляются кнопки «Войти как …», демо-пользователи
# входят без смены пароля. На стенде для жюри = true, в бою = false.
DEMO_MODE=true
# Разрешить внешние ИИ-сервисы (только для разработки). На стенде и питче = false.
ALLOW_EXTERNAL_AI=false
# Часовой пояс для интерфейса и отчётов.
TZ=Europe/Moscow

# ---------- Безопасность ----------
# Секрет для подписи JWT. Обязательно поменять: openssl rand -hex 32
SECRET_KEY=change-me-please-0123456789abcdef0123456789abcdef
# Время жизни access-токена (минуты) и refresh-токена (дни).
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Блокировка входа: после LOGIN_MAX_ATTEMPTS неудач на LOGIN_LOCK_MINUTES минут.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Cookie refresh-токена только по HTTPS (за nginx всегда true).
COOKIE_SECURE=true

# ---------- База данных ----------
# Суперпользователь PostgreSQL (владелец схемы, миграции, резервные копии).
POSTGRES_DB=trainer
POSTGRES_USER=trainer
POSTGRES_PASSWORD=trainer-dev-password
# Роль приложения: ограниченные права, в частности нет UPDATE и DELETE на журнал аудита.
APP_DB_USER=trainer_app
APP_DB_PASSWORD=trainer-app-dev-password
# Порт PostgreSQL на хосте (для тестов и инструментов с хоста).
POSTGRES_PORT=5432
# Адреса подключения (внутри compose хост = postgres).
DATABASE_URL=postgresql+asyncpg://trainer_app:trainer-app-dev-password@postgres:5432/trainer
DATABASE_ADMIN_URL=postgresql+asyncpg://trainer:trainer-dev-password@postgres:5432/trainer
# Redis: очередь фоновых задач и события.
REDIS_URL=redis://redis:6379/0
# Порт Redis на хосте.
REDIS_PORT=6379
# Тестовая база (pytest с хоста): создаётся автоматически при первом запуске тестов.
TEST_DATABASE_ADMIN_URL=postgresql+asyncpg://trainer:trainer-dev-password@localhost:5432/trainer_test
TEST_DATABASE_URL=postgresql+asyncpg://trainer_app:trainer-app-dev-password@localhost:5432/trainer_test
TEST_REDIS_URL=redis://localhost:6379/1

# ---------- Демо-пользователи (создаются командой python -m app.seed) ----------
# Пароль для admin, teacher1, teacher2, student1 … student12.
SEED_PASSWORD=Demo12345

# ---------- Сервисы ----------
# LanguageTool (проверка грамотности). Если недоступен, оценка идёт без грамотности.
LANGUAGETOOL_URL=http://languagetool:8010
# Папка данных: organizers/ (файлы организаторов, не в git) и seed/ (производные, в git).
# В контейнерах смонтирована как /data; при запуске из backend/ по умолчанию ../data.
DATA_DIR=/data
# Папка локальной модели эмбеддингов (multilingual-e5-small), появится в волне 5.
# Пусто — используется TF-IDF без модели.
EMBEDDING_MODEL_DIR=
# Порты nginx на хосте.
HTTP_PORT=80
HTTPS_PORT=443
# Имя хоста в сертификате TLS (через запятую можно несколько).
TLS_HOSTS=localhost,127.0.0.1

# ---------- Резервные копии ----------
# Время ежедневной копии (часы:минуты по TZ) и сколько последних копий хранить.
BACKUP_TIME=03:00
BACKUP_KEEP=14

# ---------- Журналирование ----------
# Уровень логов: DEBUG | INFO | WARNING | ERROR. Формат всегда JSON.
LOG_LEVEL=INFO
