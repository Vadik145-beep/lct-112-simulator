# Asterisk for the trainer (PRD 9.5): PJSIP with WebRTC for the browser softphone, UDP/TCP for
# desk phones, ARI for the backend. Configuration is in this folder; the endpoints of trainees
# are generated by the backend into /etc/asterisk/generated (shared volume).
FROM andrius/asterisk:22.10.1_debian-trixie

COPY asterisk.conf modules.conf logger.conf http.conf rtp.conf pjsip.conf extensions.conf \
     ari.conf /etc/asterisk/
COPY render-config.sh /usr/local/bin/render-config.sh
RUN chmod +x /usr/local/bin/render-config.sh \
    && mkdir -p /etc/asterisk/generated /var/spool/asterisk/recording \
    && touch /etc/asterisk/generated/endpoints.conf \
    && chown -R asterisk:asterisk /etc/asterisk/generated /var/spool/asterisk/recording

ENTRYPOINT ["/usr/local/bin/render-config.sh"]
CMD ["/usr/sbin/asterisk", "-f", "-T", "-U", "asterisk", "-p", "-n"]
